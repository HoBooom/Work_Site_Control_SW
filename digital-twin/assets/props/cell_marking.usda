#usda 1.0
(
    defaultPrim = "CellMarking"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "임시 에셋(AS-01). 셀 경계 바닥 안전선 3.6m x 3.0m. 원점은 사각형 중심."
)

def Xform "CellMarking" (
    kind = "component"
)
{
    def Cube "North"
    {
        double size = 1
        token innoworks:material = "safety_yellow"
        double3 xformOp:translate = (0, 1.46, 0.002)
        float3 xformOp:scale = (3.6, 0.08, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "South"
    {
        double size = 1
        token innoworks:material = "safety_yellow"
        double3 xformOp:translate = (0, -1.46, 0.002)
        float3 xformOp:scale = (3.6, 0.08, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "East"
    {
        double size = 1
        token innoworks:material = "safety_yellow"
        double3 xformOp:translate = (1.76, 0, 0.002)
        float3 xformOp:scale = (0.08, 2.84, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "West"
    {
        double size = 1
        token innoworks:material = "safety_yellow"
        double3 xformOp:translate = (-1.76, 0, 0.002)
        float3 xformOp:scale = (0.08, 2.84, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
