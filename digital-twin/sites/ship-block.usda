#usda 1.0
(
    defaultPrim = "ShipBlock"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """조선소 건조 도크 안 이중저 블록(ADR 0003). 도크 벽·안벽, 앞에 탑재된 선체, 뒤에 대기 블록, 골리앗 크레인. 4족 자석발 이동 용접 로봇 2대가 블록 안을 걷고 벽에 붙어 용접한다.
규칙: prim 경로 = 토픽 = 설정 키. /ShipBlock/Spider1 = ship-block/spider-1(작업 단위 = 로봇 1대).
이동 로봇 셀은 Plate가 없다. 셀 자세는 대기 위치이고, 움직이는 동안의 자세는 robot/state.base가 준다.
용접선이 놓이는 면(surfaces)은 블록 에셋 안의 기준점에서 site-config로 생성된다."""
)

def Xform "ShipBlock" (
    kind = "assembly"
    customData = {
        string "innoworks:role" = "site"
    }
)
{
    string innoworks:name = "조선소 이중저 블록 내부"

    def Xform "Env"
    {
        def "Dock" (
            references = @../assets/props/dry_dock.usda@
        )
        {
        }

        def "Block" (
            references = @../assets/props/double_bottom_block.usda@
        )
        {
        }

        def "Hull" (
            doc = "이미 탑재된 선체(작업 블록 앞, +X). 열린 끝이 작업 블록을 본다"
            references = @../assets/props/hull_section.usda@
        )
        {
            double3 xformOp:translate = (7, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "ParkedBlock" (
            doc = "탑재를 기다리는 다음 블록(뒤, -X). 같은 에셋을 다시 쓰고 용접 면 기준점은 끈다"
            references = @../assets/props/double_bottom_block.usda@
        )
        {
            double3 xformOp:translate = (-17, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            over "Surfaces" (
                active = false
            )
            {
            }
        }

        def "Goliath" (
            references = @../assets/props/goliath_crane.usda@
        )
        {
            double3 xformOp:translate = (14, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def "Quay" (
            references = @../assets/props/quay_structures.usda@
        )
        {
        }

        def "Yard" (
            references = @../assets/props/block_yard_kit.usda@
        )
        {
        }
    }

    def Xform "Spider1" (
        customData = {
            string "innoworks:role" = "cell"
        }
    )
    {
        string innoworks:name = "스파이더 1"
        double3 xformOp:translate = (-0.9, 1.2, 0.32)
        float xformOp:rotateZ = 0
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Robot" (
            customData = {
                string "innoworks:role" = "robot"
            }
        )
        {
            string innoworks:urdf = "/robots/spider-welder/robot.urdf"
            double3 xformOp:translate = (0, 0, 0.14)
            float xformOp:rotateZ = 0
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
    }

    def Xform "Spider2" (
        customData = {
            string "innoworks:role" = "cell"
        }
    )
    {
        string innoworks:name = "스파이더 2"
        double3 xformOp:translate = (3.2, 1.2, 0.32)
        float xformOp:rotateZ = 0
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "Robot" (
            customData = {
                string "innoworks:role" = "robot"
            }
        )
        {
            string innoworks:urdf = "/robots/spider-welder/robot.urdf"
            double3 xformOp:translate = (0, 0, 0.14)
            float xformOp:rotateZ = 0
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
    }
}
