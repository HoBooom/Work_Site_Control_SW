{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "alarm",
  "title": "Alarm",
  "description": "innoworks/{site}/{cell}/alarm. 서버→웹, QoS 1. 같은 alarm_id로 active=false가 오면 해제.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "ts",
    "alarm_id",
    "severity",
    "code",
    "message",
    "active"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "alarm_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "code": {
      "type": "string",
      "description": "예: CMD_REJECTED, HEARTBEAT_LOST, SCENE_CHANGED"
    },
    "message": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "cmd_id": {
      "type": "string",
      "description": "이 알람을 낸 명령(CMD_REJECTED일 때)"
    }
  }
}
