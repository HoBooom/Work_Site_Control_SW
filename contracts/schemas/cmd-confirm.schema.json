{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cmd-confirm",
  "title": "CmdConfirm",
  "description": "완료한 용접의 결과 확인. completed에서만 받는다. 웹→서버, QoS 1, retained 금지. 토픽: innoworks/{site}/{cell}/cmd/confirm",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "ts",
    "cmd_id",
    "operator",
    "task_id",
    "result"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "description": "epoch ms"
    },
    "cmd_id": {
      "type": "string",
      "minLength": 8,
      "description": "웹이 만든 명령 id(uuid). 거부 알람이 이 값을 돌려준다"
    },
    "operator": {
      "type": "string",
      "minLength": 1,
      "description": "운영자 id(로그인 전에는 브라우저마다 만든 값)"
    },
    "task_id": {
      "type": "string",
      "description": "명령 대상 작업(서버가 발급한 task_id)"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "rework"
      ],
      "description": "ok 합격, rework 재작업(같은 자리를 다시 제안)"
    }
  }
}
