{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vision-metrics",
  "title": "VisionMetrics",
  "description": "innoworks/{site}/{cell}/vision/metrics. 서버→웹, QoS 0, 1초마다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "ts",
    "latency_ms",
    "confidence",
    "disturbance"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0,
      "description": "추론 지연(ms)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "지금 제안 경로의 신뢰도"
    },
    "disturbance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "외란(조명·연기·장면 변화) 강도"
    }
  }
}
