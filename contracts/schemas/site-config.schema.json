{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "site-config",
  "title": "SiteConfig",
  "description": "digital-twin/site-config/{site}.json. 웹이 읽는 사이트 설정. 좌표는 사이트 좌표계(USD와 같음: Z-up, m, 회전 deg). 셀의 위치·회전과 surfaces는 USD에서 생성한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "site",
    "name",
    "background",
    "cells",
    "presets"
  ],
  "definitions": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "title": "Vec3"
    },
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "KebabId"
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "yaw_deg"
      ],
      "properties": {
        "position_m": {
          "$ref": "#/definitions/vec3"
        },
        "yaw_deg": {
          "type": "number",
          "description": "Z축 회전(deg). position_m은 위치(m)"
        }
      },
      "title": "Pose",
      "description": "부모 좌표계 기준 자세. 셀은 사이트 기준, 작업판(원점 모서리, 윗면 높이)과 로봇 베이스는 셀 기준"
    },
    "quat": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "title": "QuatXyzw",
      "description": "단위 쿼터니언 [x, y, z, w]"
    },
    "surfacePose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "orientation_xyzw"
      ],
      "title": "SurfacePose",
      "description": "면 좌표계의 사이트 기준 자세. 원점 = 면의 한 모서리, 면 위가 XY, +Z = 로봇이 붙는 쪽(용접하는 쪽) 법선",
      "properties": {
        "position_m": {
          "$ref": "#/definitions/vec3"
        },
        "orientation_xyzw": {
          "$ref": "#/definitions/quat"
        }
      }
    }
  },
  "properties": {
    "v": {
      "const": 1
    },
    "site": {
      "$ref": "#/definitions/kebab"
    },
    "name": {
      "type": "string"
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glb"
      ],
      "properties": {
        "glb": {
          "type": [
            "string",
            "null"
          ],
          "description": "배경 GLB 경로(public 기준). 에셋이 없으면 null"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hdri": {
          "type": [
            "string",
            "null"
          ]
        },
        "exposure": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "surfaces": {
      "type": "array",
      "description": "용접선이 놓이는 강판 면(내저판, 격벽, 외판 등). task/proposal의 surface가 가리킨다. USD에서 생성한다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "size_mm",
          "pose"
        ],
        "title": "Surface",
        "properties": {
          "id": {
            "$ref": "#/definitions/kebab"
          },
          "name": {
            "type": "string"
          },
          "size_mm": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[면 X, 면 Y]"
          },
          "pose": {
            "$ref": "#/definitions/surfacePose"
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "pose",
          "robot"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/kebab"
          },
          "name": {
            "type": "string"
          },
          "pose": {
            "$ref": "#/definitions/pose"
          },
          "plate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "size_mm",
              "pose"
            ],
            "properties": {
              "size_mm": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[가로 X, 세로 Y]"
              },
              "pose": {
                "$ref": "#/definitions/pose"
              }
            },
            "description": "고정 로봇의 작업판. 이동 로봇은 없다"
          },
          "robot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "urdf",
              "pose"
            ],
            "properties": {
              "urdf": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "URDF 경로(public 기준). 준비 전이면 null"
              },
              "pose": {
                "$ref": "#/definitions/pose"
              }
            }
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stream": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "MJPEG 주소"
              }
            }
          }
        }
      },
      "description": "작업 단위 = 로봇 1대(ADR 0003). 셀 id는 토픽의 {cell}, site는 토픽의 {site}와 같다. 고정 로봇은 작업판(plate)을 갖고, 이동 로봇은 작업판 없이 surfaces 위에서 일한다(pose는 대기 위치)"
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "eye_m",
          "target_m"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/kebab"
          },
          "name": {
            "type": "string"
          },
          "eye_m": {
            "$ref": "#/definitions/vec3"
          },
          "target_m": {
            "$ref": "#/definitions/vec3"
          }
        }
      }
    }
  }
}
