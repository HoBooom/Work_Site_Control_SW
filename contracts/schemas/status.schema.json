{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "status",
  "title": "Status",
  "description": "innoworks/{site}/{cell}/status. 서버→웹, retained. offline은 브로커가 LWT로 대신 발행한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "ts", "state"],
  "properties": {
    "v": { "const": 1 },
    "ts": { "type": "integer", "minimum": 0 },
    "state": { "type": "string", "enum": ["online", "offline"] }
  }
}
