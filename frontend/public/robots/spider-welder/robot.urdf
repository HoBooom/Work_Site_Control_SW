  <joint name="fl_hip_yaw" type="revolute">
    <parent link="base_link"/><child link="fl_hip"/>
    <origin xyz="0.15 0.13 0.06" rpy="0 0 0.959931"/><axis xyz="0 0 1"/>
    <limit lower="-1.047198" upper="1.047198" effort="60" velocity="3"/>
  </joint>
  <joint name="fl_hip_pitch" type="revolute">
    <parent link="fl_hip"/><child link="fl_thigh"/>
    <origin xyz="0.025 0 0.11"/><axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.22173" effort="60" velocity="3"/>
  </joint>
  <joint name="fl_knee" type="revolute">
    <parent link="fl_thigh"/><child link="fl_shin"/>
    <origin xyz="0.275776 0 0.231404"/><axis xyz="0 1 0"/>
    <limit lower="-2.617994" upper="2.617994" effort="60" velocity="3"/>
  </joint>
  <joint name="fl_ankle_pitch" type="revolute">
