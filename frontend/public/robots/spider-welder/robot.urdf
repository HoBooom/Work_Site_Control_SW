  <material name="cobot"><color rgba="0.70 0.71 0.72 1"/></material>
  <material name="brass"><color rgba="0.75 0.52 0.25 1"/></material>
  <material name="lens"><color rgba="0.01 0.01 0.012 1"/></material>

  <link name="base_link">
