<?xml version="1.0"?>
<!--
  생성 파일(digital-twin/assets/gen/make_robot.py). 직접 고치지 않는다.
  4족 자석발 이동 용접 로봇 대역(ADR 0003, digital-twin/assets/gen/spider.py).
  좌표: Z-up, m. base_link = 몸통 중심. 관절 0° = 서 있는 자세(발판 바닥이 base_link 아래 0.14m).
-->
<robot name="spider-welder">
  <material name="aluminum"><color rgba="0.56 0.58 0.60 1"/></material>
  <material name="carbon"><color rgba="0.035 0.037 0.04 1"/></material>
