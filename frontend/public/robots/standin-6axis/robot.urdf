<?xml version="1.0"?>
<!--
  생성 파일(digital-twin/assets/gen/make_robot.py). 직접 고치지 않는다.
  대역 6축 용접 로봇(spec 7절). 실제 기종이 정해지면 같은 관절 이름(joint_1~joint_6)으로 교체한다.
  좌표: Z-up, m. 관절 0°: 상완 수직, 전완 +X 수평.
-->
<robot name="standin-6axis">
  <material name="body"><color rgba="0.95 0.48 0.08 1"/></material>
  <material name="dark"><color rgba="0.16 0.17 0.19 1"/></material>
  <material name="steel"><color rgba="0.62 0.64 0.66 1"/></material>
  <material name="copper"><color rgba="0.80 0.48 0.28 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="meshes/base_link_dark.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <geometry><mesh filename="meshes/link_1_body.stl"/></geometry>
      <material name="body"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/link_1_dark.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <link name="link_2">
    <visual>
      <geometry><mesh filename="meshes/link_2_body.stl"/></geometry>
      <material name="body"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/link_2_dark.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <link name="link_3">
    <visual>
      <geometry><mesh filename="meshes/link_3_body.stl"/></geometry>
      <material name="body"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/link_3_dark.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <link name="link_4">
    <visual>
      <geometry><mesh filename="meshes/link_4_body.stl"/></geometry>
      <material name="body"/>
    </visual>
  </link>

  <link name="link_5">
    <visual>
      <geometry><mesh filename="meshes/link_5_dark.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <link name="link_6">
    <visual>
      <geometry><mesh filename="meshes/link_6_steel.stl"/></geometry>
      <material name="steel"/>
    </visual>
  </link>

  <link name="torch">
    <visual>
      <geometry><mesh filename="meshes/torch_copper.stl"/></geometry>
      <material name="copper"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/torch_dark.stl"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.2"/><axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="100" velocity="2"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0 0 0.25"/><axis xyz="0 1 0"/>
    <limit lower="-1.571" upper="2.356" effort="100" velocity="2"/>
  </joint>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0 0 0.7"/><axis xyz="0 1 0"/>
    <limit lower="-2.356" upper="1.571" effort="100" velocity="2"/>
  </joint>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0.6 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.316" upper="3.316" effort="50" velocity="3"/>
  </joint>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0.12 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.181" upper="2.181" effort="50" velocity="3"/>
  </joint>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/>
    <origin xyz="0.07 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-6.283" upper="6.283" effort="20" velocity="4"/>
  </joint>
  <joint name="tool_joint" type="fixed">
    <parent link="link_6"/><child link="torch"/>
    <origin xyz="0.02 0 0"/>
  </joint>
</robot>
